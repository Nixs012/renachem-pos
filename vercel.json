{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/products-get", "destination": "/api/products" },
    { "source": "/api/products-add", "destination": "/api/products?action=add" },
    { "source": "/api/products-update", "destination": "/api/products?action=update" },
    { "source": "/api/products-delete", "destination": "/api/products?action=delete" },
    { "source": "/api/sales-get", "destination": "/api/sales" },
    { "source": "/api/sales-add", "destination": "/api/sales" },
    { "source": "/api/suppliers-manage", "destination": "/api/management" },
    { "source": "/api/clients-manage", "destination": "/api/management" },
    { "source": "/api/purchases-manage", "destination": "/api/management" },
    { "source": "/api/settings-manage", "destination": "/api/management" },
    { "source": "/api/audit-log", "destination": "/api/management" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  }
}
