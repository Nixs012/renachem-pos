{
  "version": 2,
  "rewrites": [
    {
      "source": "/.netlify/functions/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/",
      "destination": "/renderer/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/renderer/:path*"
    }
  ],
  "cleanUrls": true
}
